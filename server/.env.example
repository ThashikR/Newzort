# ─────────────────────────────────────────────────────────────────────────────
# Newzort backend secrets — SERVER ONLY. Never copy these into the Expo app
# or into any EXPO_PUBLIC_* variable. Copy to server/.env (git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# LLM used for story analysis and Ask AI
ANTHROPIC_API_KEY=

# News providers / licensed feeds
NEWS_API_KEY=

# Database
DATABASE_URL=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8081
