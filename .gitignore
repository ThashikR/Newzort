# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Metro cache kept on this drive (see metro.config.js)
.metro-cache/

# local env files (keep .env.example committed)
.env
server/.env

# machine-specific npm cache location (F: drive on this PC)
.npmrc

# built news feed (published by GitHub Actions, not committed)
server/public/

# Cloudflare Worker local secrets
worker/.dev.vars
worker/.wrangler/

