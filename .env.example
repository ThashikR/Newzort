# ─────────────────────────────────────────────────────────────────────────────
# Newzort — Expo client environment (copy to `.env` for local overrides).
#
# IMPORTANT: every EXPO_PUBLIC_* value is bundled into the app and can be read
# by anyone who installs it. Only put genuinely public values here.
#
# NEVER put these in the client:
#   - LLM API keys (Anthropic, OpenAI, …)
#   - News API keys / licensed feed credentials
#   - Database credentials
# They belong in `server/.env` (see server/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# News feed base URL. Default (if unset): https://thashikr.github.io/Vartify
# Local engine: http://localhost:8787  (cd server && npm run serve)
EXPO_PUBLIC_API_URL=

# "true" = use the built-in demo stories instead of live news.
EXPO_PUBLIC_USE_MOCK_DATA=false
